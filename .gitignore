.DS_Store

# docs — keep only README files tracked
*.md
!README.md
!AGENTS.md
!CLAUDE.md

# sensitive/internal docs — explicitly ignored (also covered by *.md above)
AGENTHANDOFF.md
SOP.md
MIGRATION.md
CHANGELOG.md
docs/API_KEYS_AND_MCP.md
docs/DESIGN.md
docs/Backend-Build-Template-Convex.md

# env — never commit real secrets
.env
.env.*
!.env.example
!.env.dev.example
!**/.env.local.example

# secret material and local credential-bearing files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.csr
*.jks
*.keystore
*.kubeconfig
id_rsa*
id_ed25519*
*.jwk
*.jwks
credentials.json
service-account*.json
firebase-admin*.json
google-credentials*.json
aws-credentials*
secrets.json
secret.json
*.secret.*
*.secrets.*
*.credentials.*
credentials.*
secrets.local.*
*.local.secret.*
*.local.secrets.*

# sensitive/local docs and plans
docs/private/
docs/internal/
docs/sensitive/
docs/secrets/

# database dumps / backups / archives
/backups/
/backup/
*.dump
*.backup
*.bak
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.dump.sql
*backup*.sql

# local editor / agent state
.vscode/
.idea/
.claude/settings.local.json
.cursor/
.continue/

# coverage and generated clients
coverage/
.nyc_output/
prisma/migrations/dev.db*
/lib/generated/prisma/
nginx/certs/

# Convex generated client (regenerated by `convex dev`/codegen)
backend/convex/_generated/
backend/.convex-tmp/
