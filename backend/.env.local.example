# Convex CLI target for self-hosted backend (used by `convex dev` / `deploy`).
# Copy to .env.local and fill explicitly. DO NOT COMMIT real values.

CONVEX_SELF_HOSTED_URL=
# Generate with: docker compose --env-file .env.dev exec backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Deployment env synced with `pnpm run sync-env` or by the Docker `convex-dev`
# service. Generate auth values with `pnpm run keys`; keep values one-line.
SITE_URL=
JWT_PRIVATE_KEY=
JWKS=
TELEGRAM_API_ORIGIN=
TELEGRAM_WEBHOOK_ORIGIN=
TELEGRAM_CHAT_ID=
