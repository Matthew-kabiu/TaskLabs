# ─────────────────────────────────────────────────────────────────────────────
# TaskLabs Docker development env template.
# Copy to .env.dev, fill every value, then run:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up --build
#
# No Compose file may provide fallback values for these settings.
# Do not commit real .env.dev values.
# ─────────────────────────────────────────────────────────────────────────────

INSTANCE_NAME=
INSTANCE_SECRET=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
# Convex expects the Postgres cluster URL only; do not include /<database>.
POSTGRES_URL=
DO_NOT_REQUIRE_SSL=
DISABLE_BEACON=
RUST_LOG=

# Optional local backup config. The production stack runs this service by default.
BACKUP_CRON_SCHEDULE=
BACKUP_TIMEZONE=
BACKUP_TMPDIR=
BACKUP_OBJECT_PREFIX=
RUSTFS_ENDPOINT=
RUSTFS_REGION=
RUSTFS_BUCKET=
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=
RUSTFS_S3_ADDRESSING_STYLE=
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=

CONVEX_API_PORT=
CONVEX_API_INTERNAL_PORT=
CONVEX_SITE_PROXY_PORT=
CONVEX_SITE_INTERNAL_PORT=
CONVEX_DASHBOARD_PORT=
CONVEX_DASHBOARD_INTERNAL_PORT=
CONVEX_CLOUD_ORIGIN=
CONVEX_SITE_ORIGIN=

# In Docker, the Convex CLI watcher must talk to the backend service name.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
CONVEX_TMPDIR=

# The browser must use the host-visible Convex URL.
NEXT_PUBLIC_CONVEX_URL=
FRONTEND_PORT=
FRONTEND_INTERNAL_PORT=
FRONTEND_HOST=
FRONTEND_ORIGIN=
# Comma-separated exact browser/API origins allowed to call Next API routes.
CORS_ALLOWED_ORIGINS=
TELEGRAM_API_ORIGIN=

# Convex deployment env synced by the `convex-dev` service before `convex dev`.
# Generate auth values with `pnpm --dir backend keys`; keep values one-line.
SITE_URL=
JWT_PRIVATE_KEY=
JWKS=
FRONTEND_NODE_ENV=
BACKEND_NODE_ENV=

# Convex deployment env for Telegram chat linking. Must be a real public HTTPS
# Convex site origin before chat linking is used; no local/default fallback.
TELEGRAM_WEBHOOK_ORIGIN=

CHOKIDAR_USEPOLLING=
CHOKIDAR_INTERVAL=
WATCHPACK_POLLING=
WATCHPACK_POLLING_INTERVAL=
NEXT_TURBOPACK_ROOT=
NEXT_TELEMETRY_DISABLED=
