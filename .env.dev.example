# ─────────────────────────────────────────────────────────────────────────────
# TaskLabs (Convex) — Docker DEVELOPMENT environment template.
# Copy to .env.dev and fill every value:  cp .env.dev.example .env.dev
#
# Used by:  docker compose --env-file .env.dev -f docker-compose.dev.yml ...
# For a production stack use .env.example -> .env instead.
#
# Every key below is REQUIRED. Compose references them with ${VAR:?} so a
# missing value fails immediately rather than starting with an unsafe default.
# Values are intentionally blank here — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Convex self-hosted backend ──────────────────────────────────────────────
INSTANCE_NAME=
INSTANCE_SECRET=
CONVEX_CLOUD_ORIGIN=
CONVEX_SITE_ORIGIN=
CONVEX_API_PORT=
CONVEX_API_INTERNAL_PORT=
CONVEX_SITE_PROXY_PORT=
CONVEX_SITE_INTERNAL_PORT=
CONVEX_DASHBOARD_PORT=
CONVEX_DASHBOARD_INTERNAL_PORT=
RUST_LOG=

# ─── Convex internal storage engine (Postgres) ──────────────────────────────
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
# Internal Compose DNS host/port for Postgres clients such as backup jobs.
POSTGRES_HOST=
POSTGRES_PORT=
# Convex expects the Postgres cluster URL only; do not include /<database>.
POSTGRES_URL=
DO_NOT_REQUIRE_SSL=
DISABLE_BEACON=

# ─── DB backup to RustFS (S3-compatible) ────────────────────────────────────
# Daily midnight EAT: BACKUP_CRON_SCHEDULE=0 0 * * *, BACKUP_TIMEZONE=Africa/Nairobi
BACKUP_CRON_SCHEDULE=
BACKUP_TIMEZONE=
BACKUP_TMPDIR=
BACKUP_OBJECT_PREFIX=
RUSTFS_ENDPOINT=
RUSTFS_REGION=
RUSTFS_BUCKET=
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=
RUSTFS_S3_ADDRESSING_STYLE=
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=
# Internal URL used only by Next.js server rendering and route handlers.
CONVEX_SERVER_URL=
FRONTEND_PORT=
FRONTEND_INTERNAL_PORT=
FRONTEND_HOST=
FRONTEND_ORIGIN=
# Comma-separated exact browser/API origins allowed to call Next API routes.
CORS_ALLOWED_ORIGINS=
# Absolute filesystem root for Next/Turbopack inside the Docker build image.
NEXT_TURBOPACK_ROOT=

# ─── Convex CLI deploy target ────────────────────────────────────────────────
# Host CLI usage generally points to the host-visible Convex URL.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
CONVEX_TMPDIR=

# ─── Convex deployment env (set via `convex env set`) ───────────────────────
SITE_URL=
JWT_PRIVATE_KEY=
JWKS=

# ─── Telegram / external service origins ────────────────────────────────────
# TELEGRAM_API_ORIGIN is also required by the frontend CSP at build/dev startup.
TELEGRAM_API_ORIGIN=
TELEGRAM_WEBHOOK_ORIGIN=
# Default private Telegram chat ID used when linking the self-hosted instance.
TELEGRAM_CHAT_ID=

# ─── Development-only: containers & hot reload ───────────────────────────────
# These keys are required by docker-compose.dev.yml and are NOT used by the
# production stack. Hot reload is a dev-only concern (SOP §8).

# Node environment for the dev frontend and backend containers.
FRONTEND_NODE_ENV=
BACKEND_NODE_ENV=

# Bind-mounted source on Docker does not deliver inotify events reliably, so
# the dev watchers poll instead. Interval values are in milliseconds.
CHOKIDAR_USEPOLLING=
CHOKIDAR_INTERVAL=
WATCHPACK_POLLING=
WATCHPACK_POLLING_INTERVAL=

# Set to 1 to opt the dev container out of Next.js telemetry.
NEXT_TELEMETRY_DISABLED=
